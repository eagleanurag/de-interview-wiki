# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local aggregation output (generated by src/aggregation/aggregator.py)
/aggregation/

# Remote control plane scratch files (src/agent/).
#
# The .agent directory holds the resolved trigger and the raw event
# payload, which contains untrusted issue title and body text. It must
# never be committed, so the whole directory is ignored rather than
# individual files inside it.
.agent/
trigger.json
context.json
attempt-*.json
agent-prompt.md
report.md
job-summary.md
failure-evidence.log
agent-logs/

# Generated static site (generated by src/wiki/generator.py)
/site/
.*.staging/

# OS
.DS_Store
Thumbs.db

# Local pipeline output. Regenerated by `python -m src.pipeline`, so
# committing it would put build artifacts and enriched copies of posts
# into the repository alongside the sources they came from.
build/
